# Copy to .env and fill in. Never commit real secrets.

# Google Gemini (generation only — not used for embeddings)
# Required for POST /query answers; GET /health works without it.
GEMINI_API_KEY=

LLM_MODEL=gemini-2.5-flash

# Skip Gemini when top fused RRF score is below this (or no hits).
# Qdrant Fusion.RRF is rank-based (~sum 1/(k+rank)); calibrate after ingest.
MIN_FUSED_SCORE=0.02

# Local dense embeddings (sentence-transformers BGE-M3; prefer CUDA)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Vector store
# Host/dev: localhost. docker-compose.yml overrides to http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=atlantic_policies

# Ingest data/raw on API startup when the collection is empty.
# Compose sets AUTO_INGEST=1. Host/pytest leave this unset (default off).
# AUTO_INGEST=0
